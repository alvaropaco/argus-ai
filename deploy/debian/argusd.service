[Unit]
Description=ARGUS AI Infrastructure Runtime
Documentation=https://argus.0x-ai.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/argusd
Restart=always
RestartSec=5

# systemd creates and keeps these writable even under ProtectSystem=strict.
StateDirectory=argus
RuntimeDirectory=argus

# Least privilege, enumerated.
#
# The bootstrap argusd registers only read-only capabilities (reading /proc and
# /sys) plus the host.service.* capabilities, which reach systemd over D-Bus on
# the system bus. None of them declares a Linux capability, so the bounding set
# is correctly empty: granting more would violate the least-privilege rule,
# not satisfy it.
#
# A privileged capability added later MUST declare the exact capabilities it
# needs (see ADR-0021), and that declaration is what justifies adding a name
# here. Nothing may be added "just in case".
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# The runtime writes two paths under /etc/argus: the enrollment credential
# (/etc/argus/secrets, mode 0600, FR-035) and the cloud-managed settings
# (/etc/argus/cloud-settings.toml). ProtectSystem=strict makes both read-only,
# which breaks the feature at its first step and again at the first delivered
# configuration — both failed with EROFS against a real unit.
#
# The directory is granted as a whole rather than naming the two paths, because
# the settings file does not exist until the first configuration is applied and
# systemd refuses to start a unit whose ReadWritePaths entry is missing. Naming
# the file would make a fresh install fail to boot.
ReadWritePaths=/etc/argus
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictSUIDSGID=true
# AF_UNIX carries IPC and the D-Bus system bus. AF_INET/AF_INET6 are required for
# the outbound cloud connection (and name resolution for it); without them the
# daemon cannot reach the cloud at all, which is the feature's whole purpose.
# No other family is granted.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
