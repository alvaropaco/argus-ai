# ARGUS daemon environment overrides (systemd EnvironmentFile).
#
# This file is optional. If present, it overrides the defaults baked into
# `argusd.service`. Copy it to `/etc/default/argusd` and uncomment the lines
# you need, then run `systemctl daemon-reload && systemctl restart argusd`.

# Path to the argusd binary. Useful when ARGUS was installed via cargo
# (`cargo install --path crates/argus-daemon`) instead of the release tarball.
#
# NOTE: `argusd.service` hardens the unit with `ProtectHome=true`, which blocks
# execution from `/home`, `/root`, and `/run/user`. To run a binary from
# `~/.cargo/bin`, either symlink it into `/usr/bin` (recommended) or relax
# `ProtectHome` in a drop-in override.
#ARGUSD_BINARY=/home/user/.cargo/bin/argusd
